{
  "manifest_version": 3,
  "name": "Conversation Exporter",
  "version": "1.1.0",
  "minimum_chrome_version": "116",
  "description": "Copy or download chatbot conversations as Markdown, JSON, HTML, text or CSV. Select messages, preserve sources, and optionally download images.",
  "permissions": [
    "storage",
    "downloads",
    "clipboardWrite",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Export conversation",
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://grok.com/*",
        "https://x.com/i/grok*",
        "https://twitter.com/i/grok*",
        "https://chat.deepseek.com/*",
        "https://chat.z.ai/*",
        "https://chatglm.cn/*",
        "https://www.kimi.com/*",
        "https://kimi.com/*",
        "https://kimi.ai/*",
        "https://www.kimi.ai/*"
      ],
      "js": [
        "src/common.js",
        "src/design.js",
        "src/markdown.js",
        "src/adapters.js",
        "src/collector.js",
        "src/formats.js",
        "src/ui.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
